# Mimo LLM API
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5

# TTS API (same key, different endpoint)
TTS_API_KEY=your_tts_api_key
TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
TTS_VOICE_ID=female-warm

# STT API (语音识别 - 默认使用 SiliconFlow SenseVoice 免费模型)
# 去 https://cloud.siliconflow.cn 注册获取 API Key
STT_API_KEY=your_siliconflow_api_key
STT_BASE_URL=https://api.siliconflow.cn
STT_API_PATH=/v1/audio/transcriptions
STT_MODEL=FunAudioLLM/SenseVoiceSmall
STT_LANGUAGE=zh
STT_AUTH_MODE=bearer

# Server
SERVER_PORT=3077
